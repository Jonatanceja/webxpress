---
// i18n
import { getLangFromUrl, getRoute } from '../../../i18n/routes'
import { useTranslations } from '../../../i18n/ui'

// Components
// - Layout
import Layout from '../../../layouts/Layout.astro'
import Section from '../../../components/ui/Section.astro'
import Row from '../../../components/ui/Row.astro'
import Col from '../../../components/ui/Col.astro'
// - UI
import Hero from '../../../components/blocks/hero/PageHeader.astro'
import Button from '../../../components/ui/Button.astro'
import CTA from '../../../components/blocks/CTA/BasicDark.astro'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

// Data
import { getCollection, type CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
	const projects = await getCollection('portfolio')
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project }
	}))
}

type Props = { project: CollectionEntry<'portfolio'> }

const { project } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const { title, url, year, description, tags, screenshots } = project.data

// El texto largo lleva párrafos separados por una línea en blanco
const paragraphs = description[lang].trim().split(/\n\s*\n/)
---

<Layout title={`${title} | Webxpress`} description={project.data.summary[lang]}>
	<Hero title={title} text={project.data.summary[lang]} />

	<Section padding="top">
		<Row>
			<Col span="8">
				{paragraphs.map((paragraph) => <p class="text-lg leading-relaxed">{paragraph}</p>)}
			</Col>
			<Col span="4">
				<div class="project-meta">
					{
						tags.length > 0 && (
							<div class="project-meta__group">
								<h2 class="project-meta__title">{t.portfolioPage.whatWeDid}</h2>
								<ul class="project-meta__tags">
									{tags.map((tag) => (
										<li>{tag[lang]}</li>
									))}
								</ul>
							</div>
						)
					}
					<div class="project-meta__group">
						<h2 class="project-meta__title">{year}</h2>
					</div>
					{
						url && (
							<Button link={url} style="primary" size="base">
								{t.portfolioPage.visitSite} <Icon name="long-arrow-right" aria-hidden="true" />
							</Button>
						)
					}
				</div>
			</Col>
		</Row>
	</Section>

	{
		screenshots.length > 0 && (
			<Section padding="both">
				<Row>
					<Col span="12">
						<h2 class="sr-only">{t.portfolioPage.screenshots}</h2>
						<div class="project-shots">
							{screenshots.map((shot) => (
								<figure class="project-shots__item">
									<Image
										src={shot.src}
										alt={shot.alt[lang]}
										widths={[600, 1200]}
										sizes="(min-width: 1024px) 900px, 100vw"
										loading="lazy"
									/>
								</figure>
							))}
						</div>
					</Col>
				</Row>
				<Row>
					<Col span="12" align="center">
						<Button link={getRoute('portfolio', lang)} style="neutral" variation="link">
							{t.portfolioPage.backToList}
						</Button>
					</Col>
				</Row>
			</Section>
		)
	}

	<CTA />
</Layout>

<style>
	@reference '../../../styles/theme.css';

	.project-meta {
		@apply flex flex-col gap-6 rounded-sm border border-neutral-100 bg-neutral-50 p-6 dark:border-neutral-800 dark:bg-neutral-900;
	}
	.project-meta__title {
		@apply mb-2 text-base font-semibold text-neutral-700 dark:text-neutral-50;
	}
	.project-meta__tags {
		@apply flex flex-wrap gap-2;
	}
	.project-meta__tags li {
		@apply rounded-sm bg-white px-2 py-1 text-xs font-medium text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300;
	}
	.project-shots {
		@apply flex flex-col gap-12;
	}
	/* Las capturas son páginas completas: se muestran enteras, a lo ancho de
	   la columna, para que se lea el diseño de arriba abajo. */
	.project-shots__item {
		@apply mx-auto w-full max-w-4xl overflow-hidden rounded-sm border border-neutral-100 shadow-xl shadow-neutral-700/10 dark:border-neutral-800 dark:shadow-neutral-950/50;
	}
	.project-shots__item :global(img) {
		@apply h-auto w-full;
	}
</style>
