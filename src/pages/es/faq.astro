---
// i18n
import { getLangFromUrl } from '../../i18n/routes'
import { useTranslations } from '../../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
// Components
// - Layout
import Layout from '../../layouts/Layout.astro'
// - UI
import Hero from '../../components/blocks/hero/PageHeader.astro'
import FAQ from '../../components/blocks/FAQ/FaqSticky.astro'
import TextImage from '../../components/blocks/basic/TextImage.astro'
import CTA from '../../components/blocks/CTA/BasicDark.astro'

// Data
import { getFaq } from '../../data'

const faqData = getFaq(lang)
// - FAQ Categories
const faqPricing = faqData.filter((faq) => faq.category === 'pricing')
const faqIntegrations = faqData.filter((faq) => faq.category === 'integrations')
const faqDesign = faqData.filter((faq) => faq.category === 'design')

// Content
import faqImage1 from '../../assets/faq/faq-01.png'

// - SEO
const SEO = {
	title: t.faq.seoTitle,
	description: t.faq.seoDescription
}
// - Page Header
const header = {
	title: t.faq.headerTitle,
	text: t.faq.headerText
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<FAQ
		title={t.faqPage.pricingTitle}
		text={t.faqPage.pricingText}
		data={faqPricing}
	/>
	<TextImage
		title={t.faqPage.valueTitle}
		text={t.faqPage.valueText}
		image={faqImage1}
		mobileImage={faqImage1}
		imagePosition="left"
		offsetImage
		classes="bg-neutral-50 dark:bg-neutral-900 lg:!py-64"
	/>
	<FAQ
		title={t.faqPage.designTitle}
		text={t.faqPage.designText}
		data={faqDesign}
	/>
	<TextImage
		title={t.faqPage.resultsTitle}
		text={t.faqPage.resultsText}
		image={faqImage1}
		mobileImage={faqImage1}
		imagePosition="right"
		offsetImage
		classes="bg-neutral-50 dark:bg-neutral-900 lg:!py-64"
	/>
	<FAQ
		title={t.faqPage.integrationsTitle}
		text={t.faqPage.integrationsText}
		data={faqIntegrations}
	/>
	<CTA />
</Layout>
