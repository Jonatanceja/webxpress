---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import FormHero from '../components/blocks/hero/ContactHero.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import ContactCards from '../components/blocks/contact/ContactCards.astro'
import SocialProof from '../components/blocks/socialproof/Basic.astro'

// Content
// - SEO
const SEO = {
	title: 'Webxpress | Mantente en contacto con nosotros',
	description:
		'¿Tienes preguntas o necesitas asistencia? Contacta a Webxpress para obtener respuestas rápidas y soluciones personalizadas.'
}
// - Page Header
const header = {
	title: 'Resuelve tus dudas sobre <strong>Webxpress</strong>',
	text: "Ya sea que tengas una pregunta, necesites ayuda o simplemente quieras compartir tus comentarios, estamos para escucharte. Escríbenos y te responderemos lo antes posible."
}
---

<Layout title={SEO.title} description={SEO.description}>
	<FormHero
		title={header.title}
		text={header.text}
		id="contact"
		classes="bg-neutral-50 dark:bg-neutral-950/80"
	/>
	<ContactCards classes="dark:bg-neutral-950/80" />
	<SocialProof classes="dark:bg-neutral-950/80" />
</Layout>
