---
// i18n
import { getLangFromUrl } from '../i18n/routes'
import { useTranslations } from '../i18n/ui'
import { getTerms } from '../i18n/terms'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const sections = getTerms(lang)

// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import SidebarContent from '../components/blocks/basic/StickySidebar.astro'
import Hero from '../components/blocks/hero/PageHeader.astro'

// Content
// - SEO
const SEO = {
	title: t.terms.seoTitle,
	description: t.terms.seoDescription
}
// - Page Header
const header = {
	title: t.terms.headerTitle,
	text: t.terms.headerText
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />

	{
		t.terms.legalNotice && (
			<div class="container mx-auto px-6">
				<p class="small border-l-2 border-primary-500 py-2 pl-4">{t.terms.legalNotice}</p>
			</div>
		)
	}

	{
		sections.map((section) => (
			<SidebarContent classes={section.alt ? 'bg-neutral-50 dark:bg-neutral-900' : undefined}>
				<div slot="sidebar">
					<h3>{section.sidebarTitle}</h3>
					<p>{section.sidebarText}</p>
				</div>
				<div class="basic-text">
					{section.blocks.map((block) => (
						<Fragment>
							<h4>{block.heading}</h4>
							{block.paragraphs.map((paragraph) => (
								<p>{paragraph}</p>
							))}
						</Fragment>
					))}
				</div>
			</SidebarContent>
		))
	}
</Layout>
