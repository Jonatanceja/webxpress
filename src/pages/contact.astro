---
// i18n
import { getLangFromUrl } from '../i18n/routes'
import { useTranslations } from '../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import FormHero from '../components/blocks/hero/ContactHero.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import ContactCards from '../components/blocks/contact/ContactCards.astro'
import SocialProof from '../components/blocks/socialproof/Basic.astro'
import WhatsAppCta from '../components/blocks/contact/WhatsAppCta.astro'


// Content
// - SEO
const SEO = {
	title: t.contact.seoTitle,
	description: t.contact.seoDescription
}
// - Page Header
const header = {
	title: t.contact.headerTitle,
	text: t.contact.headerText
}
---

<Layout title={SEO.title} description={SEO.description}>
	<FormHero
		title={header.title}
		text={header.text}
		id="contact"
		classes="bg-neutral-50 dark:bg-neutral-950/80"
	/>
	<ContactCards classes="dark:bg-neutral-950/80" />
	<WhatsAppCta classes="bg-neutral-50 dark:bg-neutral-900" />
	<SocialProof classes="dark:bg-neutral-950/80" />
</Layout>
