---
// Lottie
// ------------
// Description: reproduce una animación dotLottie (.lottie) o Lottie (.json), como
// fondo a sangre de una sección o como elemento en línea junto al contenido.
//
// Decisiones que conviene conocer:
// - El reproductor se carga de forma diferida y solo cuando la animación entra en
//   pantalla, para no penalizar el arranque de la página.
// - Si el visitante pide menos movimiento (prefers-reduced-motion), se muestra el
//   primer fotograma congelado en lugar de la animación.
// - Es decorativo: queda fuera del árbol de accesibilidad con aria-hidden.

type Props = {
	/** Ruta pública del archivo, p. ej. "/hero.lottie" */
	src: string
	/** `background` cubre la sección entera; `inline` ocupa su sitio en el flujo */
	variant?: 'background' | 'inline'
	/** Ajuste del lienzo dentro del contenedor */
	fit?: 'contain' | 'cover' | 'fill'
	/** Proporción del lienzo. Solo se usa en la variante en línea */
	ratio?: string
	classes?: string
}

const { src, variant = 'background', fit, ratio = '1 / 1', classes } = Astro.props

// En un fondo interesa llenar; en línea, que se vea la animación entera
const resolvedFit = fit ?? (variant === 'background' ? 'cover' : 'contain')
---

<div
	class:list={[variant === 'background' ? 'lottie-bg' : 'lottie-inline', classes]}
	style={variant === 'inline' ? `aspect-ratio:${ratio}` : undefined}
	aria-hidden="true"
>
	<canvas class="lottie__canvas" data-lottie-src={src} data-lottie-fit={resolvedFit}></canvas>
</div>

<script>
	import type { DotLottie } from '@lottiefiles/dotlottie-web'

	const players = new WeakMap<HTMLCanvasElement, DotLottie>()

	const start = async (canvas: HTMLCanvasElement) => {
		if (players.has(canvas)) return

		const src = canvas.dataset.lottieSrc
		if (!src) return

		// El reproductor solo se descarga si de verdad hace falta
		const { DotLottie } = await import('@lottiefiles/dotlottie-web')

		const quiet = window.matchMedia('(prefers-reduced-motion: reduce)').matches

		// `fit` decide cómo se escala la animación dentro del lienzo, igual que
		// object-fit en CSS. Sin esto el reproductor usa "contain" y deja franjas
		// a los lados cuando el lienzo es más ancho que la animación.
		const fit = (canvas.dataset.lottieFit || 'cover') as
			| 'contain'
			| 'cover'
			| 'fill'
			| 'none'
			| 'fit-width'
			| 'fit-height'

		const player = new DotLottie({
			canvas,
			src,
			autoplay: !quiet,
			loop: !quiet,
			layout: { fit, align: [0.5, 0.5] },
			renderConfig: { autoResize: true }
		})

		// Con movimiento reducido, dejamos el primer fotograma visible y quieto
		if (quiet) player.addEventListener('load', () => player.setFrame(0))

		players.set(canvas, player)
	}

	const init = () => {
		const canvases = document.querySelectorAll<HTMLCanvasElement>('.lottie__canvas')
		if (!canvases.length) return

		if (!('IntersectionObserver' in window)) {
			canvases.forEach(start)
			return
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return
					start(entry.target as HTMLCanvasElement)
					observer.unobserve(entry.target)
				})
			},
			{ rootMargin: '200px' }
		)
		canvases.forEach((canvas) => observer.observe(canvas))
	}

	init()
	document.addEventListener('astro:page-load', init)
</script>

<style>
	@reference '../../styles/theme.css';

	.lottie-bg {
		@apply pointer-events-none absolute inset-0 -z-10 overflow-hidden;
	}
	.lottie-inline {
		@apply pointer-events-none w-full;
	}
	.lottie__canvas {
		@apply h-full w-full;
	}
</style>
