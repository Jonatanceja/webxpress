---
// SEO Component
// ------------
// Description: A component to add SEO meta tags to the page.
// Properties:
// - title: The page title
// - description: The page description
// - ogImage: The page image for Open Graph
// - canonical: Whether to use the canonical URL
// - noindex: Whether to add noindex and nofollow meta tags

// Props
type Props = {
	title?: string
	description?: string
	ogImage?: string
	canonical?: boolean
	noindex?: boolean
}

import { getLangFromUrl, switchLangPath, routes, type Lang } from '../../../../i18n/routes'
import { useTranslations } from '../../../../i18n/ui'

const { title, description, ogImage, canonical = true, noindex = false } = Astro.props

const lang = getLangFromUrl(Astro.url)
const other: Lang = lang === 'en' ? 'es' : 'en'
const t = useTranslations(lang)

// Alternativas por idioma para que Google sirva la versión correcta
const base = Astro.site ?? new URL(Astro.url.origin)
const alternates: { hreflang: string; href: string }[] = [
	{ hreflang: 'en', href: new URL(switchLangPath(Astro.url.pathname, 'en'), base).toString() },
	{ hreflang: 'es', href: new URL(switchLangPath(Astro.url.pathname, 'es'), base).toString() },
	{ hreflang: 'x-default', href: new URL(routes.home.en, base).toString() }
]

// Construir URL absoluta para ogImage
const imageUrl = ogImage 
	? new URL(ogImage, Astro.site || Astro.url.origin).toString()
	: undefined

// Datos de Facebook (puedes moverlos a tu config)
const fbAppId = '' // Tu Facebook App ID (opcional)
const siteName = t.site.name
---

<Fragment>
	<!-- Title -->
	{title && <title>{title}</title>}
	
	<!-- Meta Description -->
	{description && <meta name="description" content={description} />}
	
	<!-- Open Graph / Facebook -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content={Astro.url} />
	{title && <meta property="og:title" content={title} />}
	{description && <meta property="og:description" content={description} />}
	{imageUrl && <meta property="og:image" content={imageUrl} />}
	{imageUrl && <meta property="og:image:secure_url" content={imageUrl} />}
	<meta property="og:image:type" content="image/jpeg" />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content={title || siteName} />
	<meta property="og:site_name" content={siteName} />
	<meta property="og:locale" content={t.site.locale} />
	<meta property="og:locale:alternate" content={useTranslations(other).site.locale} />
	{fbAppId && <meta property="fb:app_id" content={fbAppId} />}
	
	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image" />
	{title && <meta name="twitter:title" content={title} />}
	{description && <meta name="twitter:description" content={description} />}
	{imageUrl && <meta name="twitter:image" content={imageUrl} />}
	{imageUrl && <meta name="twitter:image:alt" content={title || siteName} />}
	<!-- Opcional: Tu usuario de Twitter -->
	<!-- <meta name="twitter:site" content="@tuusuario" /> -->
	<!-- <meta name="twitter:creator" content="@tuusuario" /> -->
	
	<!-- Canonical -->
	{canonical && <link rel="canonical" href={Astro.url} />}

	<!-- Alternativas de idioma -->
	{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
	
	<!-- Robots -->
	{noindex && <meta name="robots" content="noindex,nofollow" />}
</Fragment>