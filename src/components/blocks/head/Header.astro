---
// Imports
import { ClientRouter } from 'astro:transitions'
import GoogleSearchConsole from '../../scripts/googleSearchConsole.astro'
// Partials
import Seo from './partials/Seo.astro'
// Data
import { configData } from '../../../config/config'
import { getLangFromUrl } from '../../../i18n/routes'
import { useTranslations } from '../../../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)


// Props
type Props = {
	title?: string
	description?: string
	ogImage?: string
	canonical?: boolean
	noindex?: boolean
}
// Page Metadata
const {
	title = t.site.title,
	description = t.site.description,
	ogImage = configData.ogImage,
	canonical = configData.canonical,
	noindex = configData.noindex
} = Astro.props
---

<head>
	<GoogleSearchConsole />
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<Seo
		title={title}
		description={description}
		ogImage={ogImage}
		canonical={canonical}
		noindex={noindex}
	/>
	<link rel="icon" href={configData.logo.src} type="image/svg+xml" />
	<link rel="sitemap" href="/sitemap-index.xml" />
	<meta name="generator" content={Astro.generator} />
	<meta name="theme-color" content="#134e4a" />
	<ClientRouter fallback="swap" />
</head>
