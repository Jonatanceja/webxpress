---
// Basic Contact Form
// ------------
// Description: A basic contact form with fields for first name, last name, email, phone number and message.
// Properties:
// - classes: Additional classes to be added to the block
// ------------

// Components
// - UI
import Card from '../../ui/cards/partials/Card.astro'
import CardBody from '../../ui/cards/partials/CardBody.astro'
import Form from '../../ui/forms/Form.astro'
import FormField from '../../ui/forms/partials/FormField.astro'
import InputField from '../../ui/forms/form-elements/InputField.astro'
import Button from '../../ui/Button.astro'

// i18n
import { getLangFromUrl } from '../../../i18n/routes'
import { useTranslations } from '../../../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Card classes={classes}>
	<CardBody>
		<Form 
    action="https://website.us22.list-manage.com/subscribe/post?u=2af389eb99f58a1cb65fda16a&amp;id=bd02499e98&amp;f_id=0081c2e1f0" 
    method="post" 
    target="_self" 
    novalidate
  >
  <h2 class="text-2xl">{t.contactBlocks.formTitle}</h2>
  
  <FormField>
    <InputField type="text" id="mce-FNAME" name="FNAME" label={t.contactBlocks.firstName} />
    <InputField type="text" id="mce-LNAME" name="LNAME" label={t.contactBlocks.lastName} />
  </FormField>

  <FormField>
    <InputField type="email" id="mce-EMAIL" name="EMAIL" label={t.contactBlocks.email} required value={t.contactBlocks.emailPlaceholder} />
  </FormField>

  <FormField>
    <InputField type="tel" id="mce-PHONE" name="PHONE" label={t.contactBlocks.phone} />
  </FormField>

  <FormField>
    <InputField type="text" id="mce-COMPANY" name="COMPANY" label={t.contactBlocks.company} />
  </FormField>

  <FormField>
    <label class="block w-full" for="mce-PLAN">{t.contactBlocks.plan}</label>
    <select 
	class="block relative h-12 w-full rounded-sm border border-neutral-200 px-4 text-neutral-500 placeholder-transparent outline-hidden transition-all autofill:bg-white invalid:border-red-500 invalid:text-red-500 focus:border-primary-500 focus:outline-hidden invalid:focus:border-red-500 focus-visible:outline-hidden disabled:cursor-not-allowed disabled:bg-neutral-50 disabled:text-neutral-400 dark:border-neutral-800 dark:bg-neutral-900 dark:autofill:bg-neutral-900 dark:disabled:bg-neutral-600" id="mce-PLAN" name="PLAN">
      <option value=""></option>
      <option value="Starter">Starter</option>
      <option value="Profesional">Profesional</option>
      <option value="Shopify">Shopify</option>
    </select>
  </FormField>

  {/* Campo oculto anti-bots que pide Mailchimp */}
  <div aria-hidden="true" style="position: absolute; left: -5000px;">
    <input type="text" name="b_2af389eb99f58a1cb65fda16a_bd02499e98" tabindex="-1" value="" />
  </div>

  <Button style="primary" type="submit">{t.contactBlocks.submit}</Button>
</Form>

	</CardBody>
</Card>
