---
// Basic Cards grid Section
// ------------
// Description: A grid of cards with basic contacto information in a 4 column layout.
// Properties:
// - classes: Additional classes to be added to the Section

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/BasicCard.astro'

// i18n
import { getLangFromUrl } from '../../../i18n/routes'
import { useTranslations } from '../../../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// 	Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="requests" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-balance" set:html={t.contactBlocks.title} />
			<p class="pb-0 text-lg">{t.contactBlocks.text}</p>
		</Col>
	</Row>
	<Row>
		<Col span="3">
			<Card
				title={t.contactBlocks.cards[0].title}
				subtitle={t.contactBlocks.cards[0].subtitle}
				icon="rocket"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contacto"
			/>
		</Col>
		<Col span="3">
			<Card
				title={t.contactBlocks.cards[1].title}
				subtitle={t.contactBlocks.cards[1].subtitle}
				icon="document-text"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contacto"
			/>
		</Col>
		<Col span="3">
			<Card
				title={t.contactBlocks.cards[2].title}
				subtitle={t.contactBlocks.cards[2].subtitle}
				icon="bolt"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contacto"
			/>
		</Col>
		<Col span="3" classes="flex flex-col gap-6">
			<Card
				title={t.contactBlocks.cards[3].title}
				subtitle={t.contactBlocks.cards[3].subtitle}
				icon="chat-bubble-left-ellipsis"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contacto"
			/>
		</Col>
	</Row>
</Section>
