---
// Basic Cards grid Section
// ------------
// Description: A grid of cards with basic contacto information in a 4 column layout.
// Properties:
// - classes: Additional classes to be added to the Section

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/BasicCard.astro'

// 	Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="requests" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-balance">¿Tienes una solicitud especial? ¡Estamos aquí para <strong>ayudarte!</strong></h2>
			<p class="pb-0 text-lg">
				Elige una de las opciones a continuación para recibir la ayuda específica que necesitas. 
				Ya sea soporte al cliente, consultas de ventas, solicitudes de funciones o comentarios generales, 
				estamos aquí para ofrecerte la mejor asistencia posible.

			</p>
		</Col>
	</Row>
	<Row>
		<Col span="3">
			<Card
				title="Soporte al cliente"
				subtitle="Necesitas ayuda con algún proyecto con nosotros. No dudes en ponerte en contactoo."
				icon="rocket"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contacto"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Ventas"
				subtitle="¿Interesado en nuestros planes o deseas una solución personalizada? "
				icon="document-text"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contacto"
			/>
		</Col>
		<Col span="3">
			<Card
				title="Solicitudes de funciones"
				subtitle="Quieres agregar alguna función a tu sitio web? Nosotros podemos ayudarte a hacerlo."
				icon="bolt"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contacto"
			/>
		</Col>
		<Col span="3" classes="flex flex-col gap-6">
			<Card
				title="Retroalimentación General"
				subtitle="Tus comentarios son muy valiosos. Cuéntanos cómo podemos mejorar. "
				icon="chat-bubble-left-ellipsis"
				classes="text-center dark:!bg-neutral-800/50"
				link="/contacto"
			/>
		</Col>
	</Row>
</Section>
