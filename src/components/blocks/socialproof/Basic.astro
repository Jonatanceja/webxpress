---
// Social Proof Section
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
import { Image } from 'astro:assets'

// Logos
import katana from '../../../assets/logos/katana.svg'
import addapp from '../../../assets/logos/addapp.svg'
import pgc from '../../../assets/logos/pgc.svg'
import ascend from '../../../assets/logos/ascend.svg'
import integral from '../../../assets/logos/integral-protection.svg'
import resuldt from '../../../assets/logos/resuldt.svg'

// i18n
import { getLangFromUrl } from '../../../i18n/routes'
import { useTranslations } from '../../../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const images = [
	{
		image: katana,
		alt: 'Katana Turbos',
		classes: 'max-h-10'
	},
	{
		image: addapp,
		alt: 'Addapp B.I.',
		classes: 'max-h-10'
	},
	{
		image: pgc,
		alt: 'PGC',
		classes: 'max-h-12'
	},
	{
		image: ascend,
		alt: 'Ascend Language',
		classes: 'max-h-16'
	},
	{
		image: integral,
		alt: 'Integral Protection',
		classes: 'max-h-8'
	},
	{
		image: resuldt,
		alt: 'Resuldt',
		classes: 'max-h-8'
	}
]
---

<Section padding="bottom">
	<Row>
		<Col span="12" align="center">
			<h2 class="!mb-10 text-base font-normal text-neutral-500 dark:text-neutral-400"><Fragment set:html={t.blocks.socialProof} /></h2>
		</Col>
	</Row>
	<Row flex classes="!flex-row">
		{
			images.map((item) => (
				<Col>
					<Image src={item.image} alt={item.alt} class={item.classes} />
				</Col>
			))
		}
	</Row>
</Section>
