---
// Feature Cards grid Section
// ------------
// Description: A grid of cards with feature information in a 4 column layout.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/FeatureCard.astro'

// Content
// - Cards
import feature01 from '../../../assets/cards/feature-01.svg'
import feature02 from '../../../assets/cards/feature-02.svg'
import feature03 from '../../../assets/cards/feature-03.svg'
import feature04 from '../../../assets/cards/feature-04.svg'
import feature05 from '../../../assets/cards/feature-05.svg'
---

<Section id="features">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">No más proyectos costosos ni abandonados. <strong>Tu sitio</strong> evoluciona contigo.</h2>
			<p class="pb-0 text-lg">
				Webxpress es tu plataforma para tener un sitio web moderno, rápido y sin complicaciones. 
				Paga una suscripción mensual y nosotros nos encargamos del diseño, cambios, soporte y actualizaciones.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="4">
			<Card
				title="Sitios listos en tiempo récord"
				subtitle="Desde la contratación al lanzamiento en días, no semanas. Tu sitio está en línea antes de lo que imaginas."
				image={feature01}
				link="/features"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Velocidad que sí se nota "
				subtitle="Cargan rápido, fluyen mejor y mejoran la experiencia de tus visitantes desde cualquier dispositivo."
				image={feature02}
				link="/features"
			/>
			<Card
				title="Siempre actualizado"
				subtitle="Tu sitio evoluciona contigo. Cambios mensuales incluidos para que siempre esté al día."
				image={feature03}
				link="/features"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Seguridad incluida"
				subtitle="HTTPS, protección contra errores comunes y mantenimiento técnico sin preocupaciones."
				image={feature05}
				link="/features"
			/>
			<Card
				title="Soporte que responde"
				subtitle="No estás solo. Te acompañamos con atención personalizada por correo o WhatsApp."
				image={feature04}
				link="/features"
			/>
		</Col>
	</Row>
</Section>
