---
// Feature Cards grid Section
// ------------
// Description: A grid of cards with feature information in a 4 column layout.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/FeatureCard.astro'

// Content
// - Cards
import feature01 from '../../../assets/cards/feature-01.svg'
import feature02 from '../../../assets/cards/feature-02.svg'
import feature03 from '../../../assets/cards/feature-03.svg'
import feature04 from '../../../assets/cards/feature-04.svg'
import feature05 from '../../../assets/cards/feature-05.svg'
---

<Section id="features">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">No más proyectos eternos. <strong>Tu sitio</strong> publicado en días.</h2>
			<p class="pb-0 text-lg">
				Webxpress te entrega un sitio web moderno y rápido en 5 a 15 días hábiles, con un precio cerrado
				que conoces antes de empezar. Un solo pago, sin mensualidades y sin sorpresas.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="4">
			<Card
				title="Publicado en días, no en meses"
				subtitle="5, 10 o 15 días hábiles según el paquete. Te damos la fecha de entrega antes de empezar y la cumplimos."
				image={feature01}
				link="/funciones"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Velocidad que sí se nota "
				subtitle="Cargan rápido, fluyen mejor y mejoran la experiencia de tus visitantes desde cualquier dispositivo."
				image={feature02}
				link="/funciones"
			/>
			<Card
				title="Precio cerrado"
				subtitle="Un solo pago, sin mensualidades. Sabes exactamente cuánto cuesta tu sitio desde el primer día."
				image={feature03}
				link="/funciones"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Seguridad incluida"
				subtitle="HTTPS, protección contra errores comunes y soporte técnico incluido durante el primer año."
				image={feature05}
				link="/funciones"
			/>
			<Card
				title="Soporte que responde"
				subtitle="No estás solo. Te acompañamos con atención personalizada por correo o WhatsApp."
				image={feature04}
				link="/funciones"
			/>
		</Col>
	</Row>
</Section>
