---
// Feature Cards grid Section
// ------------
// Description: A grid of cards with feature information in a 4 column layout.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/FeatureCard.astro'

// Content
// - Cards
import feature01 from '../../../assets/cards/feature-01.svg'
import feature02 from '../../../assets/cards/feature-02.svg'
import feature03 from '../../../assets/cards/feature-03.svg'
import feature04 from '../../../assets/cards/feature-04.svg'
import feature05 from '../../../assets/cards/feature-05.svg'

// i18n
import { getLangFromUrl, getRoute } from '../../../i18n/routes'
import { useTranslations } from '../../../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const featuresLink = getRoute('features', lang)
---

<Section id="features">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty" set:html={t.home.featuresTitle} />
			<p class="pb-0 text-lg">{t.home.featuresText}</p>
		</Col>
	</Row>
	<Row>
		<Col span="4">
			<Card
				title={t.home.card1Title}
				subtitle={t.home.card1Text}
				image={feature01}
				link={featuresLink}
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title={t.home.card2Title}
				subtitle={t.home.card2Text}
				image={feature02}
				link={featuresLink}
			/>
			<Card
				title={t.home.card3Title}
				subtitle={t.home.card3Text}
				image={feature03}
				link={featuresLink}
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title={t.home.card4Title}
				subtitle={t.home.card4Text}
				image={feature05}
				link={featuresLink}
			/>
			<Card
				title={t.home.card5Title}
				subtitle={t.home.card5Text}
				image={feature04}
				link={featuresLink}
			/>
		</Col>
	</Row>
</Section>
