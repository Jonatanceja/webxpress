---
// Home page CTA Section
// ------------
// Description: A centered call to action section with a Lottie animation as background.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'

// - UI
import Button from '../../ui/Button.astro'
import LottieBackground from '../../ui/LottieBackground.astro'

// i18n
import { getLangFromUrl, getRoute } from '../../../i18n/routes'
import { useTranslations } from '../../../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Animación de fondo del hero
const heroAnimation = '/hero.lottie'
---

<Section id="intro" padding="none" classes="hero relative isolate overflow-hidden">
	<LottieBackground slot="background" src={heroAnimation} />
	<Row classes="hero__content">
		<Col span="2" />
		<Col span="8" align="center">
			<h1 set:html={t.home.heroTitle} />

			<p class="pb-0 text-lg" set:html={t.home.heroText} />
			<Button size="lg" link={getRoute('pricing', lang)}>{t.home.heroCta}</Button>
		</Col>
		<Col span="2" />
	</Row>
</Section>

<style>
	@reference '../../../styles/theme.css';

	/* La animación marca la proporción del hero: al ensancharse, la altura
	   crece con ella. El min-height evita que se estreche demasiado en móvil
	   y garantiza sitio para el titular y el botón. */
	.hero {
		@apply min-h-[32rem] lg:min-h-0 lg:aspect-[1920/1080] lg:max-h-[80vh];
	}
	.hero__content {
		@apply relative z-10 py-12 lg:py-24;
	}
</style>
