---
// Home page CTA Section
// ------------
// Description: A centered call to action section with a Lottie animation as background.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'

// - UI
import Button from '../../ui/Button.astro'
import LottieBackground from '../../ui/LottieBackground.astro'

// i18n
import { getLangFromUrl, getRoute } from '../../../i18n/routes'
import { useTranslations } from '../../../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Animación de fondo del hero
const heroAnimation = '/hero.lottie'
---

{/* mode="dark" fuerza el estilo sobre fondo oscuro pase lo que pase con el tema:
    la animación es siempre oscura, así que en modo claro el texto quedaría negro
    sobre negro. bg-transparent evita que la sección pinte su propio fondo encima. */}
<Section
	id="intro"
	padding="none"
	mode="dark"
	classes="relative isolate min-h-[28rem] overflow-hidden bg-transparent"
>
	<LottieBackground slot="background" src={heroAnimation} />
	<Row classes="relative z-10 py-32 lg:py-56">
		<Col span="2" />
		<Col span="8" align="center">
			<h1 set:html={t.home.heroTitle} />

			<p class="pb-0 text-lg" set:html={t.home.heroText} />
			<Button size="lg" link={getRoute('pricing', lang)}>{t.home.heroCta}</Button>
		</Col>
		<Col span="2" />
	</Row>
</Section>
