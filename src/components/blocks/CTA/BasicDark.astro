---
// Basic Dark Call To Action section
// ------------
// Description: A centered call to action section that contains: a title, text, background image, notification and a button.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import CTA from '../../ui/CTA.astro'
import Button from '../../ui/Button.astro'
import ChipNotification from '../../ui/ChipNotification.astro'
import { Image } from 'astro:assets'
import Highlight from '../../ui/Highlight.astro'

// Content
import ctaImage from '../../../assets/cta-dark-bg.webp'
import badge from '../../../assets/rocket.svg'

// i18n
import { getLangFromUrl, getRoute } from '../../../i18n/routes'
import { useTranslations } from '../../../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Section>
	<Row>
		<Col span="1" />
		<Col span="10">
			<CTA
				title={t.blocks.ctaTitle}
				text={t.blocks.ctaText}
				mode="dark"
				bg={ctaImage}
			>
				<ChipNotification radius="rounded-full" classes="mb-6 box">
					<Image src={badge} alt="Product of the Year" class="h-12 w-12 animate-bounce" slot="button" />
					<span class="hidden md:block">{t.blocks.ctaTagline}</span>
					<Highlight classes="md:ml-2"> Webxpress </Highlight>
				</ChipNotification>
				<a href="/contacto" aria-label="Comienza ya">
				<Button size="lg" style="primary" link={getRoute('contact', lang)}>{t.blocks.ctaButton}</Button>
				</a>
			</CTA>
		</Col>
		<Col span="1" />
	</Row>
</Section>
