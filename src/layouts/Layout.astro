---
// Imports
// Components
import NavigationBar from '../components/ui/NavigationBar.astro'
import Main from '../components/ui/Main.astro'
import Footer from '../components/ui/Footer.astro'
import AuditPopup from '../components/blocks/modal/AuditPopup.astro'
import Header from '../components/blocks/head/Header.astro'
// Scripts
import Scriprs from '../components/scripts/LocalScripts.astro'
import LanguageDetector from '../components/scripts/LanguageDetector.astro'
import MailChimp from '../components/scripts/mailChimp.astro'
// Styles
import '../styles/global.css'
// Fonts
import '@fontsource-variable/inter'
import '@fontsource-variable/outfit'
// Data
import { configData } from '../config/config'
import { getLangFromUrl } from '../i18n/routes'
import { useTranslations } from '../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// El popup de auditoría sólo va en la portada. Al decidirlo aquí, en el resto
// de páginas Astro no renderiza el componente ni envía su script.
const path = Astro.url.pathname.replace(/\/+$/, '')
const isHome = path === '' || path === '/es'

// Props
type Props = {
	title?: string
	description?: string
	ogImage?: string
	noindex?: boolean
	classes?: string
}
// Page Metadata
const { title, description, ogImage, noindex, classes } = Astro.props
---

<!doctype html>
<html lang={lang} class="scroll-animation mode-auto relative">
	<Header title={title} description={description} ogImage={ogImage} noindex={noindex} />
	<LanguageDetector />
	<body
		class:list={[
			{ ['mode-' + `${configData.mode}`]: configData.mode },
			{ ['scroll-animation']: configData.scrollAnimations },
			{ [`${classes}`]: classes }
		]}
	>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WH7SNGXJ"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<a class="skip-link" href="#main-content">{t.lang.skipToContent}</a>
		<MailChimp />
		<NavigationBar />
		<Main>
			<slot />
		</Main>
		<Footer />
		{isHome && <AuditPopup />}
		<Scriprs />
	</body>
</html>
